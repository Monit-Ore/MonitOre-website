# Acrescente estas variáveis ao .env.dev (ambiente atual do app.js).
# Para produção, configure-as no ambiente usado pelo servidor.
GOLD_FONTE=s3
GOLD_S3_BUCKET=monitore-ouro-2026
# Vazio se os JSONs estiverem na raiz do bucket; exemplo de pasta: panorama
GOLD_S3_PREFIXO=
# Preencha com a região real do bucket.
AWS_REGION=
# Datas sem fuso do tratamento são interpretadas como horário de São Paulo.
GOLD_FUSO=-03:00

# Para testar sem S3, substitua GOLD_FONTE por local e configure:
# GOLD_PASTA_LOCAL=D:/FACULDADE/PI/MonitOre-python/ouro
# Credenciais AWS: use o perfil/role do servidor ou variáveis de ambiente.
# Não coloque credenciais no frontend.
